{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mobile-common",
      "hidden": true,
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "RESONITH_BUILD_FUZZERS": "OFF",
        "RESONITH_BUILD_CUDA_FOUNDRY": "OFF",
        "RESONITH_BUILD_TOOLS": "OFF",
        "RESONITH_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "android-common",
      "hidden": true,
      "inherits": "mobile-common",
      "generator": "Ninja",
      "toolchainFile": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_PLATFORM": "android-26",
        "ANDROID_STL": "c++_static",
        "RESONITH_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android ARM64 production Core",
      "inherits": "android-common",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86-64 emulator Core",
      "inherits": "android-common",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64"
      }
    },
    {
      "name": "ios-common",
      "hidden": true,
      "inherits": "mobile-common",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_REQUIRED": "NO",
        "RESONITH_BUILD_SHARED": "OFF"
      }
    },
    {
      "name": "ios-device-arm64",
      "displayName": "iOS device ARM64 static Core",
      "inherits": "ios-common",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_SYSROOT": "iphoneos"
      }
    },
    {
      "name": "ios-simulator-x86_64",
      "displayName": "iOS simulator x86-64 static Core",
      "inherits": "ios-common",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_SYSROOT": "iphonesimulator"
      }
    },
    {
      "name": "ios-simulator-arm64",
      "displayName": "iOS simulator ARM64 static Core",
      "inherits": "ios-common",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_SYSROOT": "iphonesimulator"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64",
      "jobs": 4
    },
    {
      "name": "android-x86_64",
      "configurePreset": "android-x86_64",
      "jobs": 4
    },
    {
      "name": "ios-device-arm64",
      "configurePreset": "ios-device-arm64",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "ios-simulator-x86_64",
      "configurePreset": "ios-simulator-x86_64",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "ios-simulator-arm64",
      "configurePreset": "ios-simulator-arm64",
      "configuration": "Release",
      "jobs": 4
    }
  ]
}
